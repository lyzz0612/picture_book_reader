{
  "id": "book_028",
  "title": "小雅去幼儿园",
  "coverPath": "books/book_028/cover.png",
  "mode": "textOnly",
  "estimatedMinutes": 6,
  "category": "sceneExperience",
  "pages": [
    {
      "id": "p1",
      "segments": [
        {
          "id": "s1",
          "text": "今天是小雅第一天去幼儿园！妈妈帮小雅背上书包，书包上有一只可爱的小花朵图案。"
        },
        {
          "id": "s2",
          "text": "小雅有点紧张，紧紧拉着妈妈的手："妈妈，幼儿园里有小朋友吗？有玩具吗？""
        },
        {
          "id": "s3",
          "text": ""当然有啦！"妈妈笑着说，"幼儿园里有好多好朋友，还有好多好玩的玩具！""
        }
      ]
    },
    {
      "id": "p2",
      "segments": [
        {
          "id": "s4",
          "text": "幼儿园到了！门口站着一位笑眯眯的老师，穿着漂亮的连衣裙。"小朋友你好呀！我是老师！"老师温柔地说。"
        },
        {
          "id": "s5",
          "text": "小雅小声说："老师好……"老师蹲下来，轻轻地抱了抱小雅："别怕，这里很安全！""
        },
        {
          "id": "s6",
          "text": "妈妈和小雅挥挥手："妈妈下午来接你！"小雅看着妈妈走远，眼泪在眼眶里打转。"
        }
      ]
    },
    {
      "id": "p3",
      "segments": [
        {
          "id": "s7",
          "text": "走进教室，小雅看见好多小朋友：小明、小红、小兔、小狗……他们正在玩玩具！"
        },
        {
          "id": "s8",
          "text": "一只小兔子跑过来："你好！我是小兔，我们一起玩积木吧！"小雅点点头，和小兔一起搭积木。"
        },
        {
          "id": "s9",
          "text": "小狗也跑过来："我们搭一个高高的城堡吧！"三个好朋友一起动手，搭了一个好大好大的城堡！"
        }
      ]
    },
    {
      "id": "p4",
      "segments": [
        {
          "id": "s10",
          "text": ""叮铃铃——"上课铃响了！老师说："小朋友们，我们来学唱歌吧！""
        },
        {
          "id": "s11",
          "text": "大家一起唱："太阳当空照，花儿对我笑，小鸟说早早早，你为什么背上小书包……""
        },
        {
          "id": "s12",
          "text": "小雅唱得很认真，声音甜甜的，像小黄鹂在树上唱歌一样好听！"
        }
      ]
    },
    {
      "id": "p5",
      "segments": [
        {
          "id": "s13",
          "text": "中午到了，大家排着队去洗手，然后坐在餐桌前吃饭。今天的午饭是香喷喷的米饭、甜甜的胡萝卜、嫩嫩的青菜。"
        },
        {
          "id": "s14",
          "text": "小雅大口大口地吃着，吃得真香！老师笑着说："小雅吃得真好！""
        },
        {
          "id": "s15",
          "text": "吃完午饭，大家躺在小床上睡午觉。小雅躺在软软的小床上，一会儿就睡着了。"
        }
      ]
    },
    {
      "id": "p6",
      "segments": [
        {
          "id": "s16",
          "text": "下午，大家一起做游戏。老师说："我们来玩老鹰捉小鸡吧！""
        },
        {
          "id": "s17",
          "text": "小狗当老鹰，老师当母鸡，小朋友们当小鸡。小雅紧紧拉住前面小兔的衣服，跑呀跑，躲呀躲，老鹰怎么也抓不到她！"
        },
        {
          "id": "s18",
          "text": "大家玩得开心极了，笑声像银铃一样！"
        }
      ]
    },
    {
      "id": "p7",
      "segments": [
        {
          "id": "s19",
          "text": "放学时间到了！妈妈来接小雅了。小雅扑进妈妈怀里："妈妈！我今天在幼儿园玩得好开心！""
        },
        {
          "id": "s20",
          "text": ""真的吗？"妈妈笑着问。"真的！我认识了小兔、小狗，我们一起搭积木、唱歌、做游戏！""
        },
        {
          "id": "s21",
          "text": ""明天我还要来幼儿园！"小雅说。妈妈亲了亲小雅："我们小雅长大了！""
        }
      ]
    }
  ]
}
